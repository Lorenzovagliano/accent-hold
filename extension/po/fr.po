#: prefs.js:48
msgid "Shortcuts"
msgstr "Raccourcis"

#: prefs.js:49
msgid "Open the variants directly for a base letter."
msgstr "Ouvrez directement les variantes d’une lettre de base."

#: prefs.js:55
msgid "Enable or disable all accent shortcuts."
msgstr "Active ou désactive tous les raccourcis d’accentuation."

#: prefs.js:62
msgid "Lowercase accents"
msgstr "Accents minuscules"

#: prefs.js:63
msgid "Press Ctrl+Super+letter, then choose a number."
msgstr "Appuyez sur Ctrl+Super+lettre, puis choisissez un numéro."

#: prefs.js:68
msgid "Uppercase accents"
msgstr "Accents majuscules"

#: prefs.js:69
msgid "Add Shift: Ctrl+Super+Shift+letter, then choose a number."
msgstr "Ajoutez Maj : Ctrl+Super+Maj+lettre, puis choisissez un numéro."

#: prefs.js:77
msgid "Behavior"
msgstr "Comportement"

#: prefs.js:82
msgid "Delay before display"
msgstr "Latence avant affichage"

#: prefs.js:83
msgid "Milliseconds before the popup appears."
msgstr "Millisecondes avant l’apparition de la popup."

#: prefs.js:96
msgid "Auto-close (failsafe)"
msgstr "Auto-fermeture (failsafe)"

#: prefs.js:97
msgid "Milliseconds before automatic close."
msgstr "Millisecondes avant fermeture automatique."

#: prefs.js:113
msgid "Accentable characters"
msgstr "Caractères accentuables"

#: prefs.js:114
msgid "JSON table: base key → list of accented variants."
msgstr "Table JSON : touche de base → liste de variantes accentuées."

#: prefs.js:150
msgid "Modified = saved automatically."
msgstr "Modifié = enregistré automatiquement."

#: prefs.js:154
msgid "Save"
msgstr "Enregistrer"

#: prefs.js:158
msgid "Reset"
msgstr "Réinitialiser"

#: prefs.js:175
msgid "Built-in default table active."
msgstr "Table intégrée par défaut active."

#: prefs.js:181
msgid "Invalid JSON — not saved: "
msgstr "JSON invalide — non enregistré : "

#: prefs.js:185
msgid "Saved."
msgstr "Enregistré."

#: prefs.js:205
msgid "Reset to the built-in table."
msgstr "Réinitialisé à la table intégrée."

#: prefs.js:230
msgid "Keyboards"
msgstr "Claviers"

#: prefs.js:231
msgid ""
"Layouts where the accent shortcuts are active (none checked = all active)."
msgstr ""
"Layouts où les raccourcis d’accentuation sont actifs (aucun coché = tous "
"actifs)."

#: prefs.js:259
msgid "No xkb layout detected"
msgstr "Aucun layout xkb détecté"

#: prefs.js:260
msgid "The accent shortcuts are active on all keyboards."
msgstr "Les raccourcis d’accentuation sont actifs sur tous les claviers."
